  "cards": [
    {
      "dot": "cyan",
      "title": "双层结构：母本与项目分离",
      "items": [
        "选题库存母本（topic_id），剧本库存项目（script_id），一个母本 1 : N 反复开发成多个项目",
        "母本未结构化入库时保留 ref_text 原文顶上——两条通道至少填一条，宁可待补录也不为凑关系而错绑",
        "旧台账 5 套 ID 并行、跨表靠 VLOOKUP 与人肉记颜色；新结构以单一 script_id 打通一切"
      ]
    },
    {
      "dot": "emerald",
      "title": "五类页面覆盖主用户旅程",
      "items": [
        "剧本列表 → 剧本详情 → 全局看板 → 我的待办 → 管理后台",
        "列表承载检索与筛选，详情承载全字段、状态时间线与复盘",
        "看板把「周会数据准备约半天」压到 ≤10 分钟"
      ]
    },
    {
      "dot": "rose",
      "title": "权限与留痕是硬约束",
      "items": [
        "成本字段在列表、详情、导出、接口四处对未授权角色均不返回",
        "审计日志不可编辑、不可删除，保留期 ≥180 天",
        "权限变更本身也写入审计日志"
      ]
    },
    {
      "dot": "amber",
      "title": "本期的三条范围红线",
      "items": [
        "语义 / 向量查重（W-07）——v1.0 只做文件指纹 + 归一化主名 + 相似度候选",
        "移动端（W-10）——只做桌面网页版",
        "替换钉钉、提报采买策划创作四环节、财务结算、外部承制方门户均不在本期"
      ]
    },
    {
      "dot": "slate",
      "title": "防平台锁定的硬约束",
      "items": [
        "全量业务数据（选题库、剧本库、子母关系、审计日志）必须可导出为通用格式",
        "数据模型与底层存储解耦，不绑定特定 BaaS",
        "钉钉表格在业务验证通过前保持事实源，中台数据可回滚"
      ]
    }
  ]
