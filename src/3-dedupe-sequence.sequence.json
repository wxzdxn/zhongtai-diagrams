  "cards": [
    {
      "dot": "emerald",
      "title": "查重永不阻断（P7）",
      "items": [
        "无论是否命中候选，用户均可继续上传——查重是推荐器，不是守门员",
        "命中时「一键绑定」与「继续上传（不是重复）」两个按钮并列展示",
        "把绑定设为默认唯一路径是明确禁止的交互设计"
      ]
    },
    {
      "dot": "amber",
      "title": "5 秒响应预算",
      "items": [
        "文件指纹 + 归一化剧名是查重的全部输入，v1.0 不做语义向量检索",
        "归一化涵盖去空格、繁简转换、大小写统一三项",
        "组合筛选响应超 3 秒展示加载态，超 10 秒必须返回明确错误而非空白"
      ]
    },
    {
      "dot": "rose",
      "title": "防滥用的标记",
      "items": [
        "用户选「不是重复」时必须落一条标记，供后续人工复核",
        "重复上传同一文件提示已存在并展示候选，但不得阻断上传",
        "同一部剧被重复录入时展示候选并引导至既有记录，同样不阻断创建"
      ]
    },
    {
      "dot": "violet",
      "title": "建 ID 是唯一性关口（P1）",
      "items": [
        "校验通过才生成 script_id；不通过则拒绝保存并提示具体原因",
        "script_id 一经生成不可变更、不可复用",
        "唯一 ID 覆盖率是 0% → 100% 的硬指标"
      ]
    }
  ]
